#!/usr/bin/env python3

from __future__ import annotations

import argparse
import hashlib
import os
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
POLICY_SOURCE = ROOT / "policies/development-workflow.md"
CODEX_POLICY_TARGET = ROOT / "codex/skills/git-workflow/references/development-workflow.md"
FINGERPRINT_SOURCE = ROOT / "codex/skills/git-workflow/scripts/review_fingerprint.py"


def git_root(path: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"not a git repository: {path}")
    return Path(result.stdout.strip()).resolve()


def generated_policy() -> bytes:
    source = POLICY_SOURCE.read_bytes()
    digest = hashlib.sha256(source).hexdigest()
    header = (
        "<!-- GENERATED FILE: DO NOT EDIT. "
        f"source=dotfiles/policies/development-workflow.md sha256={digest} -->\n\n"
    ).encode()
    return header + source


def atomic_write(path: Path, content: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, raw_tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(raw_tmp)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


def check_or_write(path: Path, content: bytes, mode: int, check: bool) -> bool:
    matches = path.is_file() and path.read_bytes() == content and (path.stat().st_mode & 0o777) == mode
    if check:
        return matches
    if not matches:
        atomic_write(path, content, mode)
    return True


def main() -> None:
    parser = argparse.ArgumentParser(description="Sync the shared development policy into Codex and a repository.")
    parser.add_argument("--repo", required=True, help="Target repository root")
    parser.add_argument("--check", action="store_true", help="Check generated files without writing")
    args = parser.parse_args()

    repo = git_root(Path(args.repo))
    targets = [
        (CODEX_POLICY_TARGET, generated_policy(), 0o644),
        (repo / ".agent/policies/development-workflow.generated.md", generated_policy(), 0o644),
        (repo / ".agent/scripts/review_fingerprint.py", FINGERPRINT_SOURCE.read_bytes(), 0o755),
    ]

    mismatches = [str(path) for path, content, mode in targets if not check_or_write(path, content, mode, args.check)]
    if mismatches:
        for path in mismatches:
            print(f"out of sync: {path}")
        raise SystemExit(1)

    action = "verified" if args.check else "synchronized"
    print(f"development workflow policy {action}: {repo}")


if __name__ == "__main__":
    main()
